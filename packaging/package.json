{
  "schema": 1,
  "name": "tsuswico",
  "winget": "tsudev.SWICO",
  "homepage": "https://swico.tsudev.com",
  "license": "Apache-2.0",
  "description": {
    "vi": "Kiểm tra bản quyền Windows, Office và thu thập cấu hình phần cứng",
    "en": "Windows and Office license audit and hardware inventory"
  },
  "release": {
    "repo": "tsudev-org/tsuswico",
    "tagRegex": "^v(?<version>[0-9]{2}\\.[1-9][0-9]?\\.[0-3][0-9][0-9]{2})$",
    "sums": "SHA256SUMS.txt"
  },
  "assets": {
    "windows-x64": {
      "file": "tsuswico_{version}_windows-x64-portable.zip",
      "kind": "portable",
      "bin": "swico.exe"
    },
    "windows-x64-installer": {
      "file": "tsuswico_{version}_windows-x64-setup.exe",
      "kind": "installer",
      "installer": "inno"
    }
  },
  "channels": [
    "winget",
    "scoop"
  ],
  "planned": []
}
