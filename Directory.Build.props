<Project>
  <!-- ============================================================
       NGUON SU THAT DUY NHAT cho metadata cua toan bo giai phap.
       Doi version O DAY -> exe, installer va winget manifest deu
       lay theo. Khong khai bao Version trong tung .csproj nua.

       Dang so hieu: YY.M.DDNN (.standards/docs/DESIGN_SYSTEM.md muc 6)
         26.8.1901 = ban thu 01 ngay 19/08/2026
         26.8.1902 = ban thu 02 CUNG ngay
         26.8.2001 = ban thu 01 ngay 20/08/2026
       DD va NN deu PHAI du hai chu so - xem docs/VERSIONING.md.
       ============================================================ -->
  <PropertyGroup>
    <VersionPrefix>26.11.2001</VersionPrefix>
    <Company>TsuDEV</Company>
    <Authors>TsuDEV</Authors>
    <Product>Tsu Swico</Product>
    <Copyright>Copyright (c) 2026 TsuDEV</Copyright>
    <Description>Kiểm tra bản quyền Windows và thu thập cấu hình phần cứng</Description>
    <RepositoryUrl>https://github.com/tsudev-org/tsuswico</RepositoryUrl>
    <!-- Khoa phien ban goi NuGet (ke ca goi bac cau) trong packages.lock.json. CI restore bang
         che do locked-mode: goi doi ma lock file khong doi => do (OpenSSF Scorecard Pinned-Dependencies, AN1). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Khong dong goi NuGet => co dinh PackageVersion de lock file KHONG doi theo moi ban phat hanh
         (ProjectReference ghi phien ban goi cua du an duoc tham chieu vao lock file). Version, FileVersion,
         InformationalVersion van lay tu VersionPrefix nhu cu. -->
    <PackageVersion>1.0.0</PackageVersion>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Canh bao = loi. Bat duoc sau khi da don sach 27 canh bao ton dong;
         de mo lai thi chung tich tu tro lai va khong ai doc nua.
         Cac quy tac duoc tat co ly do cu the nam trong .editorconfig. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
